<?xml version="1.0" encoding="UTF-8"?>
<!--
  Self-collision matrix for the UFACTORY xArm 5.

  The <disable_collisions> matrix below is generated, not hand-written, and is the
  only part SelfCollisionMatrixRule.from_collision_srdf consumes. Regenerate it
  whenever the collision geometry changes - which a different hardware variant does,
  since the model number the serial number encodes selects a different mesh set for
  every link:

      rule = SelfCollisionMatrixRule()
      rule.compute_self_collision_matrix(robot=robot)
      rule.save_self_collision_matrix(robot_name="UF_ROBOT", file_name="xarm5.srdf")

  The generator seeds its sampling, so it is reproducible. It was run against the
  world XArm5.get_xacro_mappings() expands, i.e. the 1305 variant. The pre-1300
  variant yields one pair more, link2/link5, because it uses the visual meshes as
  collision geometry; disabling that pair on a 1305 arm would let link5 pass through
  link2 unchecked.

  The <group> and <group_state> entries are not read by CRAM. They are kept so this
  stays a valid, MoveIt-usable SRDF.
-->
<robot name="UF_ROBOT">
  <!-- The planning group: the 5 revolute joints of the arm. -->
  <group name="xarm5">
    <joint name="world_joint" />
    <joint name="joint1" />
    <joint name="joint2" />
    <joint name="joint3" />
    <joint name="joint4" />
    <joint name="joint5" />
    <joint name="joint_eef" />
  </group>

  <!-- Named configurations. -->
  <group_state name="home" group="xarm5">
    <joint name="joint1" value="0" />
    <joint name="joint2" value="0" />
    <joint name="joint3" value="0" />
    <joint name="joint4" value="0" />
    <joint name="joint5" value="0" />
  </group_state>
  <group_state name="hold-up" group="xarm5">
    <joint name="joint1" value="0" />
    <joint name="joint2" value="0" />
    <joint name="joint3" value="0" />
    <joint name="joint4" value="-1.5708" />
    <joint name="joint5" value="0" />
  </group_state>

  <!-- Generated: link pairs that never need to be checked against each other. -->
  <disable_collisions link1="link1" link2="link2" />
  <disable_collisions link1="link1" link2="link_base" />
  <disable_collisions link1="link2" link2="link3" />
  <disable_collisions link1="link2" link2="link4" />
  <disable_collisions link1="link2" link2="link_base" />
  <disable_collisions link1="link3" link2="link4" />
  <disable_collisions link1="link3" link2="link5" />
  <disable_collisions link1="link4" link2="link5" />
</robot>

# Copy to `.env` and fill in API_KEY. `.env` is gitignored; keep secrets there.
#
# `run_in_docker.sh` forwards `.env` into the container, 
# so real-LLM commands work both on the host and in Docker.

# --- Standard OpenAI ---
# CLIENT_TYPE=OpenAI
# API_KEY=sk-...
# BASE_URL=https://api.openai.com/v1

# Model + retry/round config is separate from credentials and lives in
# config/llm.json (template: config/llm.example.json); 
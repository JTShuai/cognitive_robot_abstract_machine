# Copy to `.env` and fill in API_KEY. `.env` is gitignored; keep secrets there.
#
# `run_in_docker.sh --with-llm-credentials` forwards `.env` into the container,
# so real-LLM commands work both on the host and in Docker.

# --- DeepSeek (OpenAI-compatible endpoint) ---
# CLIENT_TYPE=OpenAI
# API_KEY=sk-...
# BASE_URL=https://api.deepseek.com/v1

# Any other OpenAI-compatible provider works the same way: keep
# CLIENT_TYPE=OpenAI and point BASE_URL at that provider's endpoint.

# Model + retry/round config is separate from credentials and lives in
# config/llm.json (template: config/llm.example.json), which names the
# DeepSeek model to call.
